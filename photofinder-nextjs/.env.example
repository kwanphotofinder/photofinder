# ==============================================================================
# PhotoFinder — Complete Environment Variables Configuration (.env)
# ==============================================================================
#
# 📋 QUICK REFERENCE FOR LOCAL DEVELOPMENT:
# ─────────────────────────────────────────────────────────────────────────────
# 🟢 MANDATORY (You MUST provide real credentials):
#    - CLOUDINARY_URL               (Image storage & CDN)
#    - GOOGLE_CLIENT_ID / SECRET    (Google OAuth login on localhost:3000)
#    - SUPER_ADMIN_EMAIL            (Your email address for admin rights)
#
# 🔵 PRE-CONFIGURED (Works out of the box with Docker / local defaults):
#    - DATABASE_URL / DIRECT_URL    (Defaults to local Postgres container)
#    - AI_SERVICE_URL               (Defaults to local AI container / port 8000)
#    - APP_URL / NEXT_PUBLIC_...    (Defaults to http://localhost:3000)
#
# 🟡 DUMMY VALUE OK (Any random test string works on local):
#    - JWT_SECRET                   (e.g., "dev-secret-key-12345")
#    - CRON_SECRET                  (e.g., "dev-cron-token-12345")
#
# ⚪ CAN SAFELY IGNORE (Optional features — leave empty without errors):
#    - GROQ_API_KEY                 (Chatbot assistant — skipped if empty)
#    - GMAIL_USER / GMAIL_APP_PWD   (Email notifications — skipped if empty)
#    - LINE_*                       (LINE notifications — skipped if empty)
#
# ─────────────────────────────────────────────────────────────────────────────
# Instructions:
# 1. Copy this file to create your actual '.env' file:
#    cp .env.example .env
# 2. Update the mandatory fields.
# 3. NEVER commit your actual '.env' file to GitHub (.env is in .gitignore).
# ==============================================================================


# ==============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# [STATUS ON LOCAL: 🔵 PRE-CONFIGURED — NO ACTION NEEDED IF USING DOCKER]
# ==============================================================================

# [Option A: Running with Local Docker on your Mac (Default & Ready to Use)]
# When running 'docker compose up', PostgreSQL is automatically started with pgvector.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facesearch"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/facesearch"

# [Option B: Running on the University Linux Server (Docker Production)]
# Set a strong custom password when deploying to the university Linux host:
# DATABASE_URL="postgresql://photofinder:YourStrongUniPassword@postgres:5432/photofinder_db"
# DIRECT_URL="postgresql://photofinder:YourStrongUniPassword@postgres:5432/photofinder_db"

# [Option C: Using Neon Cloud Database]
# If you prefer to connect to Neon Cloud instead of running Postgres in Docker:
# DATABASE_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-direct.region.aws.neon.tech/neondb?sslmode=require"


# ==============================================================================
# 2. SECURITY & AUTHENTICATION
# [STATUS ON LOCAL: 🟡 DUMMY OK for JWT/Cron | 🟢 MANDATORY for Super Admin]
# ==============================================================================

# A secret key used to sign and verify user JWT login session tokens.
# On Local: You can use any random string (e.g. "dev-secret-key-12345").
# On Server: Generate a 32-byte hex string ('openssl rand -hex 32').
JWT_SECRET="dev-secret-key-change-in-production-12345"

# The email address that automatically receives Super Admin privileges upon login.
# On Local & Server: Set this to your actual email (e.g. your university email).
SUPER_ADMIN_EMAIL="admin.lead@lamduan.mfu.ac.th"

# A secret token used to authenticate automated daily cleanup (/api/cron/cleanup).
# On Local: Can be any dummy string.
# On Server: A strong random string triggered by server cron or GitHub Actions.
CRON_SECRET="dev-cron-token-12345"


# ==============================================================================
# 3. GOOGLE OAUTH LOGIN
# [STATUS ON LOCAL: 🟢 MANDATORY — Real Google Cloud credentials required]
# ==============================================================================
# How to get:
# 1. Open Google Cloud Console -> APIs & Services -> Credentials.
# 2. Create an "OAuth 2.0 Client ID" (Web application type).
# 3. In "Authorized JavaScript origins", add:
#    - http://localhost:3000
# 4. In "Authorized redirect URIs", add:
#    - http://localhost:3000/login
# 5. Paste Client ID and Secret below:

NEXT_PUBLIC_GOOGLE_CLIENT_ID="1234567890-abcdefg.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="1234567890-abcdefg.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_client_secret_here"


# ==============================================================================
# 4. IMAGE STORAGE & CDN (Cloudinary)
# [STATUS ON LOCAL: 🟢 MANDATORY — Real Cloudinary credentials required]
# ==============================================================================
# How to get:
# 1. Sign up / log in to https://cloudinary.com (Free tier).
# 2. On your Dashboard, copy the "API Environment variable" (cloudinary://...).
# 3. Paste it below:
CLOUDINARY_URL="cloudinary://123456789012345:AbCdEfGhIjKlMnOpQrStUvWxYz@your_cloud_name"


# ==============================================================================
# 5. AI FACE RECOGNITION MICROSERVICE
# [STATUS ON LOCAL: 🔵 PRE-CONFIGURED — NO ACTION NEEDED IF USING DOCKER]
# ==============================================================================

# [Option A: Running with Local Docker Compose (Default & Automatic)]
# Inside Docker, Next.js communicates with the AI service container directly.
AI_SERVICE_URL="http://ai-service:7860"

# [Option B: Running on Mac with 'npm run dev' outside Docker]
# If you run Python AI service separately on your laptop port 8000:
# AI_SERVICE_URL="http://localhost:8000"

# [Option C: Using Live Hugging Face Space fallback]
# AI_SERVICE_URL="https://kwanphotofinder-photofinder-ai.hf.space"


# ==============================================================================
# 6. APPLICATION URLS (Frontend & Backend Routing)
# [STATUS ON LOCAL: 🔵 PRE-CONFIGURED — Ready for localhost:3000]
# ==============================================================================

# Internal Next.js API route base. Keep as "/api".
NEXT_PUBLIC_API_URL="/api"

# Web URL:
# On Local: "http://localhost:3000"
# On Server: "https://photofinder.your-org.ac.th"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ==============================================================================
# 7. CHATBOT ASSISTANT (Groq AI — Optional)
# [STATUS ON LOCAL: ⚪ OPTIONAL — Safe to leave empty / ignore]
# ==============================================================================
# In-app AI helper chatbot. If omitted, the chatbot feature gracefully disables.
# Free API key at https://console.groq.com (starts with gsk_).
GROQ_API_KEY=""


# ==============================================================================
# 8. NOTIFICATIONS — GMAIL & LINE (Optional)
# [STATUS ON LOCAL: ⚪ OPTIONAL — Safe to leave empty / ignore]
# ==============================================================================

# [Gmail Alerts] Sends emails when photos match. Safe to leave empty on local.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# [LINE Alerts] Pushes notifications via LINE Messaging API. Safe to leave empty.
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_REDIRECT_URI="http://localhost:3000/api/auth/line/callback"
